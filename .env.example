# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_NODE_ENV=development
BASE_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (default). Adjust the provider in prisma/schema.prisma if using another DB.
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ── NextAuth ───────────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000/api/auth

# ── OAuth Providers ────────────────────────────────────────────────────────────
# Google — https://console.developers.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — https://developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# WKE SSO (custom provider — uncomment in env.mjs and auth.ts to enable)
# WKESSO_CLIENT_ID=
# WKESSO_CLIENT_SECRET=
# WKESSO_CALLBACK_URL=http://localhost:3000/api/auth/callback/wkesso
